## AAD 資訊 (從 Azure Portal 取得)
AAD_CLIENT_ID='your-client-id'
AAD_CLIENT_SECRET='your-client-secret'
AAD_TENANT_ID='your-tenant-id'

## Postgresql DB (本機開發用)
DB_HOST=localhost
DB_PORT=6433
POSTGRES_DB=prompt_library
POSTGRES_USER=prompt_user
POSTGRES_PASSWORD=your-secure-password

## Flask Secret Key (必須改成強密碼)
SECRET_KEY='your-very-secure-secret-key-change-in-production'
# WEB設置
ADMINS=['admin1@example.com', 'admin2@example.com']
REDIRECT_URI='http://localhost:5000/auth/callback'

# MCP API
PROMPT_LIBRARY_API='http://localhost:5000'

## Claude API (用於自動生成 tags)
ANTHROPIC_API_KEY='your-anthropic-api-key'
ANTHROPIC_BASE_URL="https://api.anthropic.com/v1" # if you are using a different base URL, change it here
ANTHROPIC_MODEL="model_name"